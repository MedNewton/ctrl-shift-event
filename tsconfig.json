{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "jsx": "react-jsx",
      "strict": true,
      "noEmit": true,
      "allowJs": true,
      "checkJs": false,
      "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
      "esModuleInterop": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
  
      "types": ["vite/client"]
    },
    "include": [
      "src",
      "vite.config.*"
    ]
  }
  